{
  "tasks": {
    "dev": "deno run -A npm:vite --port 3000",
    "build": "deno run -A npm:vite build && deno run -A npm:typescript",
    "serve": "deno run -A npm:vite preview",
    "test": "deno run -A npm:vitest run",
    "install": "deno install --allow-scripts --allow-env --allow-read npm:vite",
    "deno:cache": "deno cache --reload npm:vite npm:@vitejs/plugin-react npm:@tailwindcss/vite npm:@tanstack/react-router npm:@tanstack/react-router-devtools npm:@tanstack/router-plugin npm:react npm:react-dom npm:react-markdown npm:rehype-highlight npm:rehype-raw npm:rehype-sanitize npm:remark-gfm"
  },
  "imports": {
    "vite": "npm:vite@^6.1.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.3.4",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.0.6",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.114.3",
    "@tanstack/react-router-devtools": "npm:@tanstack/react-router-devtools@^1.114.3",
    "@tanstack/router-plugin/vite": "npm:@tanstack/router-plugin@^1.114.3",
    "@tanstack/router-plugin": "npm:@tanstack/router-plugin@^1.114.3",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "react-markdown": "npm:react-markdown@^10.1.0",
    "rehype-highlight": "npm:rehype-highlight@^7.0.2",
    "rehype-raw": "npm:rehype-raw@^7.0.0",
    "rehype-sanitize": "npm:rehype-sanitize@^6.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "clsx": "npm:clsx@^2.1.1",
    "tailwind-merge": "npm:tailwind-merge@^3.0.2",
    "lucide-react": "npm:lucide-react@^0.476.0",
    "next-themes": "npm:next-themes@^0.4.5",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "tailwindcss": "npm:tailwindcss@^4.0.12",
    "tailwindcss-animate": "npm:tailwindcss-animate@^1.0.7",
    "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.1.2",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.16",
    "typescript": "npm:typescript@^5.7.2",
    "@types/react": "npm:@types/react@^19.0.8",
    "@types/react-dom": "npm:@types/react-dom@^19.0.3"
  }
}
